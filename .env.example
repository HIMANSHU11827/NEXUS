# NEXUS AI environment template. Copy to `.env` and fill in real values.
# Secrets are loaded through the Secret Manager; never commit real values.

# Core
NEXUS_ENV=development
NEXUS_STATE_DIR=.nexus
NEXUS_LOG_LEVEL=INFO

# Providers (API-key providers expect their key here)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Local providers
OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat

# Gateway credentials (only set the ones you enable)
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SIGNAL_PHONE_NUMBER=
META_VERIFY_TOKEN=

# Gateway supervision
NEXUS_GATEWAY_CONNECT_TIMEOUT=30
