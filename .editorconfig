root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml}]
indent_size = 2

[*.{js,ts,tsx,jsx,json}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf

[*.ps1]
end_of_line = crlf
