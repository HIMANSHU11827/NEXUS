{
  "name": "ask_question",
  "version": "1.0.0",
  "description": "Ask the user a multiple-choice question and optionally allow a custom answer",
  "entry": "scripts/ask_question.py",
  "class": "AskQuestionTool",
  "params": {
    "prompt": {"type": "string", "description": "Question to show the user", "required": true},
    "options": {"type": "array", "items": {"type": "string"}, "description": "One to eight answer choices", "required": true},
    "allow_custom": {"type": "boolean", "description": "Allow the user to type an answer not listed", "default": true}
  },
  "category": "interaction",
  "execution": {
    "read_only": false,
    "max_parallel": 1,
    "retry_side_effects": false
  }
}
