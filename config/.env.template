# NEXUS AI - UNIVERSAL GATEWAY CONFIGURATION
# Copy this to .env and fill in your credentials to achieve Remote Sovereignty.

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=your_telegram_token_here
ALLOWED_TELEGRAM_IDS=12345678,87654321,admin_username

# --- DISCORD ---
DISCORD_BOT_TOKEN=your_discord_token_here
ALLOWED_DISCORD_IDS=123456789012345678,user_id_2

# --- WHATSAPP (via provider) ---
WHATSAPP_TOKEN=your_whatsapp_token_here
ALLOWED_WHATSAPP_IDS=+1234567890

# --- META (FB/IG) ---
FACEBOOK_TOKEN=your_fb_token_here
ALLOWED_FACEBOOK_IDS=id1,id2
INSTAGRAM_TOKEN=your_ig_token_here
ALLOWED_INSTAGRAM_IDS=id1

# --- LLM PROVIDERS ---
OPENROUTER_API_KEY=your_openrouter_key_here
NEXUS_OPENROUTER_TEST_MODEL=openrouter/free
COMMANDCODE_API_KEY=your_commandcode_key_here

# --- SYSTEM SETTINGS ---
NEXUS_MODE=SOVEREIGN
LOG_LEVEL=INFO
WORKSPACE_PATH=./workspace

# --- INTERNET RELEASE SECURITY ---
# Set these in the deployment secret store; never commit real values.
NEXUS_PUBLIC_DEPLOYMENT=true
NEXUS_ALLOW_LOCAL_ANON=false
NEXUS_SANDBOX_TIER=normal
NEXUS_CORS_ORIGINS=https://your-dashboard.example.com
NEXUS_DASHBOARD_TOKEN=replace-with-a-long-random-token
NEXUS_SESSION_SECRET=replace-with-a-long-random-secret
NEXUS_OAUTH_SECRET=replace-with-a-long-random-secret
